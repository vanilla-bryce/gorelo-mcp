# Copy this file to .env in the same folder and fill it in.
# .env is read at startup. It must never be committed anywhere.

# Required. A Gorelo API key. Create a READ-ONLY key first - you can add a
# second key with write scope later, once you trust the write tool.
GORELO_API_KEY=

# Required for assignee "me". Must match your Gorelo user's email exactly.
GORELO_MY_EMAIL=you@example.com

# Optional.
GORELO_BASE_URL=https://api.aue.gorelo.io

# Optional. Leave as false until you have watched the read tools for a while.
# When false, every write tool refuses every call.
GORELO_ALLOW_WRITES=false

# Optional. Where gorelo_get_invoice_pdf saves PDFs. Default ~/gorelo-invoices
# GORELO_DOWNLOAD_DIR=

# Optional. The ONLY folder gorelo_add_ticket_comment can attach files from.
# Default ~/gorelo-attachments. Put a file here on purpose to attach it.
# GORELO_ATTACH_DIR=
